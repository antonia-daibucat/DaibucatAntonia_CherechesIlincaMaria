<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProGymMobile.Views.HomePage"
             Title="HomePage">
    
    
        <StackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <Label 
                Text="Bun Venit la Pro Gym!"
                FontSize="32"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center"
                FontAttributes="Bold" />

            <Label 
                Text="Alege secțiunea dorită din meniul de mai jos."
                FontSize="Medium"
                HorizontalOptions="Center" />
            <Button 
                Text="Profilul Meu"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                CornerRadius="10"
                Padding="20"
                Clicked="OnProfileClicked"
                FontSize="Large" />
            <Button 
                Text="Orarul Clase de Grup"
                BackgroundColor="{StaticResource Secondary}"
                TextColor="White"
                CornerRadius="10"
                Padding="20"
                Margin="0, 20, 0, 0"
                Clicked="OnClaseFitnessClicked"
                FontSize="Large" />

        </StackLayout>
   
</ContentPage>