<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProGymMobile.Views.ClaseFitnessPage"
             Title="Orarul Claselor"
             xmlns:viewmodels="clr-namespace:ProGymMobile.ViewModels"
             xmlns:models="clr-namespace:ProGymMobile.Models"
             x:DataType="viewmodels:ClaseFitnessViewModel">

    <Grid RowDefinitions="Auto, *" Padding="10">

        <ActivityIndicator 
            IsRunning="{Binding IsBusy}" 
            IsVisible="{Binding IsBusy}" 
            Color="{StaticResource Primary}" 
            Grid.Row="0" 
            HorizontalOptions="Center" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Clase}"
                        SelectionMode="None">

			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:ClasaFitnessDTO">

					<Frame Margin="5" Padding="15" CornerRadius="10" HasShadow="True">
						<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="5">

							<Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding NumeClasa}"
                                   FontSize="Large"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

							<Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding OraInceput, StringFormat='{0:dddd}, ora {0:t}'}"
                                   FontSize="Small"
                                   FontAttributes="Italic"
                                   TextColor="{StaticResource Secondary}" />

							<Label Grid.Row="2" Grid.Column="0"
                                   Text="{Binding Antrenor, StringFormat='Antrenor: {0}'}"
                                   FontSize="Small"
                                   TextColor="#555" />

							<Image Grid.RowSpan="3" Grid.Column="1"
                                   Source="arrow_right.png"
                                   HeightRequest="20"
                                   WidthRequest="20"
                                   VerticalOptions="Center" />

						</Grid>
					</Frame>

				</DataTemplate>
			</CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <StackLayout VerticalOptions="CenterAndExpand">
                    <Label Text="Nu există clase programate." 
                           HorizontalOptions="Center" 
                           IsVisible="{Binding IsListEmpty}" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>