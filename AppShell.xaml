<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProGymMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProGymMobile"
    xmlns:views="clr-namespace:ProGymMobile.Views"
    Title="ProGymMobile">

    <TabBar>

        <ShellContent
            Title="Acasă"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePageRoute" />

    </TabBar>

    <Shell.FlyoutContent>
        <ShellContent
            Title="Clase Fitness"
            ContentTemplate="{DataTemplate views:ClaseFitnessPage}"
            Route="ClaseFitnessRoute" />
    </Shell.FlyoutContent>

</Shell>
