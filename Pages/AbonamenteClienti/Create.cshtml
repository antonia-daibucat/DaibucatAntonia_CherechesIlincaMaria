@page
@model DaibucatAntonia_CherechesIlincaMaria.Pages.AbonamenteClienti.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>AbonamentClient</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="AbonamentClient.User.Email" class="control-label">Email Client</label>
                <input name="ClientEmail" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="AbonamentClient.AbonamentId" class="control-label"></label>
                <select asp-for="AbonamentClient.AbonamentId" class ="form-control" asp-items="ViewBag.AbonamentId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="AbonamentClient.DataInceput" class="control-label"></label>
                <input asp-for="AbonamentClient.DataInceput" class="form-control" />
                <span asp-validation-for="AbonamentClient.DataInceput" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AbonamentClient.DataSfarsit" class="control-label"></label>
                <input asp-for="AbonamentClient.DataSfarsit" class="form-control" />
                <span asp-validation-for="AbonamentClient.DataSfarsit" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AbonamentClient.Activ" /> @Html.DisplayNameFor(model => model.AbonamentClient.Activ)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
