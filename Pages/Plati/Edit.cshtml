@page
@model DaibucatAntonia_CherechesIlincaMaria.Pages.Plati.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Plata</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Plata.PlataId" />
            <div class="form-group">
                <label asp-for="Plata.AbonamentClientId" class="control-label"></label>
                <select asp-for="Plata.AbonamentClientId" class="form-control" asp-items="ViewBag.AbonamentClientId" ></select>
                <span asp-validation-for="Plata.AbonamentClientId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Plata.Suma" class="control-label"></label>
                <input asp-for="Plata.Suma" class="form-control" />
                <span asp-validation-for="Plata.Suma" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Plata.DataPlata" class="control-label"></label>
                <input asp-for="Plata.DataPlata" class="form-control" />
                <span asp-validation-for="Plata.DataPlata" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Plata.MetodaPlata" class="control-label"></label>
                <input asp-for="Plata.MetodaPlata" class="form-control" />
                <span asp-validation-for="Plata.MetodaPlata" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
