@page
@model DaibucatAntonia_CherechesIlincaMaria.Pages.ClaseFitness.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ClasaFitness[0].NumeClasa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClasaFitness[0].Descriere)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClasaFitness[0].Antrenor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClasaFitness[0].Zi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClasaFitness[0].Ora)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ClasaFitness) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NumeClasa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descriere)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Antrenor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Zi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ora)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
