@page
@model DaibucatAntonia_CherechesIlincaMaria.Pages.Users.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>User</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Email)
        </dd>
        
        
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Nume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Nume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Prenume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Prenume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Telefon)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Telefon)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User.Rol)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User.Rol)
        </dd>
    </dl>
</div>
<h4>Istoric Abonamente</h4>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>Tip Abonament</th>
            <th>Data Inceput</th>
            <th>Data Sfarsit</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.User.AbonamenteClient)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Abonament.NumeAbonament)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataInceput)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataSfarsit)
                </td>
                <td>
                    @(item.Activ ? "Activ" : "Inactiv")
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.User.UserId">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
